<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/window_background" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="16dp" android:paddingBottom="12dp">
  <include layout="@layout/view_home_brand_bar" />
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/item_border" android:layout_marginTop="8dp" />
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:id="@+id/receive_home" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:paddingTop="20dp" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginBottom="20dp">
          <LinearLayout android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="20dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
              <TextView android:id="@+id/local_endpoint_device_name" android:layout_width="wrap_content" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="36sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
              <TextView android:id="@+id/receiver_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:maxWidth="160dp" android:maxLines="2" android:text="@string/tv_ready" android:textSize="14sp" android:textColor="@color/primary_text" android:tag="tv-accent" />
            </LinearLayout>
            <TextView android:id="@+id/receiver_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/tv_receiver_description" android:textSize="15sp" android:textColor="@color/primary_text" android:tag="tv-muted" />
            <Button android:id="@+id/enable_receiver_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv_enable" android:textAllCaps="false" android:tag="tv-outline" android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone" />
          </LinearLayout>
          <View android:layout_width="1dp" android:layout_height="64dp" android:background="@color/item_border" />
          <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="24dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_folder" android:tint="@color/primary_text" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tv_save_location" android:textSize="14sp" android:textColor="@color/primary_text" android:tag="tv-muted" />
              <TextView android:id="@+id/receiver_save_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="17sp" android:textColor="@color/primary_text" android:maxLines="2" android:ellipsize="middle" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tv_send_content" android:textSize="24sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tv_send_description" android:textSize="14sp" android:textColor="@color/primary_text" android:tag="tv-muted" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:padding="3dp">
          <LinearLayout android:id="@+id/content_action_file" android:layout_width="0dp" android:layout_weight="1" android:layout_height="116dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:tag="tv-card" android:clickable="true" android:focusable="true" android:descendantFocusability="blocksDescendants" android:layout_marginEnd="12dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_description" android:tint="@color/primary_text" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/content_action_file" android:textSize="24sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tv_file_hint" android:textSize="13sp" android:textColor="@color/primary_text" android:tag="tv-muted" android:layout_marginTop="4dp" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:id="@+id/content_action_folder" android:layout_width="0dp" android:layout_weight="1" android:layout_height="116dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:tag="tv-card" android:clickable="true" android:focusable="true" android:descendantFocusability="blocksDescendants" android:layout_marginEnd="12dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_folder" android:tint="@color/primary_text" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/content_action_folder" android:textSize="24sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tv_folder_hint" android:textSize="13sp" android:textColor="@color/primary_text" android:tag="tv-muted" android:layout_marginTop="4dp" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:id="@+id/content_action_clipboard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="116dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:tag="tv-card" android:clickable="true" android:focusable="true" android:descendantFocusability="blocksDescendants">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_content_paste" android:tint="@color/primary_text" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/content_action_clipboard" android:textSize="24sp" android:textColor="@color/primary_text" android:fontFamily="sans-serif-medium" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tv_clipboard_hint" android:textSize="13sp" android:textColor="@color/primary_text" android:tag="tv-muted" android:layout_marginTop="4dp" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/pending_send_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:tag="tv-panel" android:visibility="gone" android:baselineAligned="false">
          <LinearLayout android:id="@+id/pending_send_details" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp" android:tag="tv-row" android:clickable="true" android:focusable="true" android:descendantFocusability="blocksDescendants">
            <TextView android:id="@+id/pending_send_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/primary_text" />
            <TextView android:id="@+id/pending_send_names" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/primary_text" android:tag="tv-muted" android:maxLines="1" android:ellipsize="end" />
          </LinearLayout>
          <Button android:id="@+id/choose_receiver_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/choose_receiver" android:textAllCaps="false" android:textSize="16sp" android:drawableEnd="@drawable/ic_tv_chevron" android:drawablePadding="12dp" android:tag="tv-primary" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/send_devices" android:visibility="gone" android:paddingTop="16dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/devices_back_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="?android:attr/homeAsUpIndicator" android:contentDescription="@string/navigate_up" android:tag="tv-icon" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/choose_receiver" android:textSize="26sp" android:textColor="@color/primary_text" android:layout_weight="1" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/device_pending_send_bar" android:tag="tv-row" android:layout_marginTop="16dp" android:padding="12dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="@color/primary_text" android:id="@+id/device_pending_send_summary" />
        <Button android:id="@+id/change_content_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/tv_change_content" android:textAllCaps="false" android:textSize="16sp" android:tag="tv-outline" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/nearby_devices" android:textSize="14sp" android:textColor="@color/primary_text" android:tag="tv-muted" />
        <ImageButton android:id="@+id/refresh_button" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_refresh" android:contentDescription="@string/refresh_devices" android:tag="tv-icon" />
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_receivers_found" android:textSize="16sp" android:textColor="@color/primary_text" android:id="@+id/discovery_status" android:tag="tv-muted" android:gravity="center" android:padding="24dp" />
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/device_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="4dp" />
    </LinearLayout>
  </FrameLayout>
  <FrameLayout android:id="@+id/received_text_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <Button android:id="@+id/background_button" android:layout_width="wrap_content" android:layout_height="48dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/tv_background" android:textSize="15sp" android:textAllCaps="false" android:tag="tv-outline" />
    <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
    <TextView android:id="@+id/receiver_footer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/primary_text" android:tag="tv-muted" />
    <View android:layout_width="1dp" android:layout_height="16dp" android:background="@color/item_border" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tv_same_network" android:textSize="12sp" android:textColor="@color/primary_text" android:tag="tv-muted" />
  </LinearLayout>
</LinearLayout>
