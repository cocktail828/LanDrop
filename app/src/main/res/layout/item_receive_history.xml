<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:layout_marginBottom="8dp" android:minHeight="80dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp"
    android:tag="tv-card" android:focusable="true" android:clickable="true">
    <ImageView android:id="@+id/history_file_icon" android:layout_width="44dp" android:layout_height="44dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:orientation="vertical">
        <TextView android:id="@+id/history_file_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/primary_text" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/history_file_details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/secondary_text" android:textSize="16sp" />
    </LinearLayout>
    <TextView android:id="@+id/history_file_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="18sp" android:textColor="@color/secondary_text" />
</LinearLayout>
