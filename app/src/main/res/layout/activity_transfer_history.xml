<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/window_background"
    android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingTop="20dp" android:paddingBottom="20dp">
    <include layout="@layout/view_tv_brand_bar" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/transfer_history_back_button" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="@string/navigate_up" android:padding="12dp"
            android:src="?android:attr/homeAsUpIndicator" android:tint="@color/secondary_text" android:tag="tv-icon" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:text="@string/history" android:textSize="28sp"
            android:textStyle="bold" android:textColor="@color/primary_text" />
        <TextView android:id="@+id/open_directory_button" android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="@string/open_directory" android:textSize="16sp" android:tag="tv-row" android:clickable="true" />
        <TextView android:id="@+id/clear_history_button" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="@string/delete_history_records" android:textSize="16sp" android:tag="tv-row" android:clickable="true" />
        <Button android:id="@+id/transfer_history_cancel_all" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_marginStart="12dp" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:text="@string/stop_all_transfers" android:textAllCaps="false" android:tag="tv-outline" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/transfer_history_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="32dp" android:text="@string/tv_history_empty"
        android:textSize="18sp" android:textColor="@color/secondary_text" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/transfer_history_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:padding="4dp" />
    <FrameLayout android:id="@+id/received_text_container" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone" />
    <include layout="@layout/view_tv_status_footer" />
</LinearLayout>
