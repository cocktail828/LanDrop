<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:layout_marginBottom="8dp" android:minHeight="88dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:tag="tv-card">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="16dp"
        android:src="@drawable/ic_description" android:tint="@color/secondary_text" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/active_transfer_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/primary_text" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/active_transfer_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/secondary_text" android:textSize="16sp" android:visibility="gone" />
        <TextView android:id="@+id/active_transfer_progress_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/secondary_text" android:textSize="16sp" />
        <ProgressBar android:id="@+id/active_transfer_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
            android:max="100" android:progress="0" android:progressTint="@color/brand_primary" />
    </LinearLayout>
    <TextView android:id="@+id/active_transfer_percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="72dp" android:layout_marginStart="20dp" android:gravity="end"
        android:textColor="@color/primary_text" android:textSize="24sp" />
</LinearLayout>
