<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/window_background" android:orientation="vertical" android:paddingStart="64dp" android:paddingEnd="64dp" android:paddingTop="24dp" android:paddingBottom="24dp">
  <include layout="@layout/view_tv_brand_bar" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@color/window_background" android:elevation="0dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="0dp" android:paddingEnd="8dp">
    <ImageButton android:id="@+id/transfer_center_back_button" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/navigate_up" android:padding="12dp" android:src="?android:attr/homeAsUpIndicator" android:tint="@color/secondary_text" android:tag="tv-icon" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/transfer_center" android:textColor="@color/primary_text" android:textSize="26sp" android:textStyle="bold" />
    <Button android:id="@+id/transfer_center_cancel_all" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="16dp" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/stop_all_transfers" android:textAllCaps="false" android:tag="tv-outline" android:visibility="gone" />
  </LinearLayout>
  <TextView android:id="@+id/transfer_center_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="32dp" android:text="@string/transfer_center_empty" android:textColor="@color/secondary_text" android:textSize="16sp" />
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/transfer_center_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="8dp" />
  <LinearLayout android:id="@+id/transfer_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:tag="tv-panel" android:visibility="gone">
    <TextView android:id="@+id/transfer_result_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="@color/primary_text" />
    <TextView android:id="@+id/transfer_result_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:tag="tv-muted" android:layout_marginTop="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
      <Button android:id="@+id/transfer_history" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="16dp" android:text="@string/history" android:tag="tv-outline" android:textAllCaps="false" />
      <Button android:id="@+id/transfer_done" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="16dp" android:text="@string/tv_complete" android:tag="tv-primary" android:textAllCaps="false" />
    </LinearLayout>
  </LinearLayout>
  <include layout="@layout/view_tv_status_footer" />
</LinearLayout>
